<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_liquid_aurora">

    <!-- TOP SECTION -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_igirs_logo" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Joshua"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"/>
            
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
            
        <ImageButton
            android:id="@+id/btnSidebarSettings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#7E8B9F"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- SEARCH BAR -->
    <EditText
        android:id="@+id/etSidebarSearch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_sidebar_search"
        android:hint="Search chats..."
        android:textColor="@android:color/white"
        android:textColorHint="#4E5B70"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:singleLine="true"/>

    <!-- NEW CHAT BUTTON -->
    <LinearLayout
        android:id="@+id/btnNewChatSidebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_sidebar_new_chat"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_plus"
            app:tint="#00F0FF" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Chat"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#24FFFFFF"
        android:layout_marginVertical="8dp"/>

    <!-- CHAT HISTORY RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"/>

    <!-- BOTTOM SECTION -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#24FFFFFF"/>
        
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/btnSidebarSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#7E8B9F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Cyber Security Dashboard"
                android:textColor="#A0AEC0"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSidebarMemory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_save"
                app:tint="#7E8B9F"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memory Vault"
                android:textSize="14sp"
                android:textColor="#A0AEC0"
                android:layout_marginStart="14dp"/>
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/btnSidebarClearAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#7E8B9F"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear All Chats"
                android:textSize="14sp"
                android:textColor="#A0AEC0"
                android:layout_marginStart="14dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
