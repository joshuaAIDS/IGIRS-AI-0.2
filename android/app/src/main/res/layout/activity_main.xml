<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_liquid_aurora">

    <!-- TOP NAVIGATION BAR (Matching ChatGPT reference) -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Left: Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_round_nav_button"
            android:src="@drawable/ic_menu"
            android:contentDescription="Settings Menu" />

        <!-- Top Center: Model Selector Pill ("✦ IGIRS AI 2.0 ▼") -->
        <LinearLayout
            android:id="@+id/btnModelPill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_centerInParent="true"
            android:background="@drawable/bg_model_pill"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/electric_cyan" />

            <TextView
                android:id="@+id/tvModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-bold"
                android:text="IGIRS 2.0 Fast"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#8E9EB5" />
        </LinearLayout>

        <!-- Top Right: New Chat Button -->
        <ImageButton
            android:id="@+id/btnNewChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_round_nav_button"
            android:src="@drawable/ic_new_chat"
            android:contentDescription="New Chat" />
    </RelativeLayout>

    <!-- CHAT MESSAGES RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomCommandBar"
        app:layout_constraintTop_toBottomOf="@+id/topBar" />

    <!-- EMPTY STATE QUICK ACTIONS (Matching ChatGPT layout) -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/bottomCommandBar"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- Action 1: Vision / Camera -->
        <LinearLayout
            android:id="@+id/actionVisionPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_image"
                app:tint="#A0AEC0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif"
                android:text="Vision &amp; camera inspection"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Action 2: Daily Briefing / Memory -->
        <LinearLayout
            android:id="@+id/actionBriefingPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chat_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_pencil"
                app:tint="#A0AEC0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif"
                android:text="Daily briefing &amp; memory vault"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Action 3: Web / Protocols -->
        <LinearLayout
            android:id="@+id/actionToolsPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chat_action_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_globe"
                app:tint="#A0AEC0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif"
                android:text="Run system tools &amp; protocols"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM COMMAND INPUT PILL CONTAINER (Matching ChatGPT) -->
    <LinearLayout
        android:id="@+id/bottomCommandBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Attachment Pre-Send Preview Chip (Dismissible) -->
        <LinearLayout
            android:id="@+id/layoutAttachmentPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_cyber_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAttachmentThumb"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image" />

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:text="Attachment"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#8E9EB5" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_chat_input_pill"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <!-- Attachment (+) Button -->
            <ImageButton
                android:id="@+id/btnAddAttachment"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_plus"
                android:contentDescription="Add attachment" />

            <!-- Text Input Field -->
            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="Ask IGIRS AI..."
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:textColor="#FFFFFF"
                android:textColorHint="#7E8B9F"
                android:textSize="15sp" />

            <!-- Mic Dictation Button -->
            <ImageButton
                android:id="@+id/btnMicDictation"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic"
                android:contentDescription="Voice Dictation"
                app:tint="#A0AEC0" />

            <!-- Send Button (Visible when text is entered) -->
            <ImageButton
                android:id="@+id/btnSendChat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_send"
                android:visibility="gone"
                android:contentDescription="Send"
                app:tint="@color/electric_cyan" />

            <!-- Blue Circular Waveform Voice Session Button -->
            <ImageButton
                android:id="@+id/btnWaveformVoice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_voice_waveform_button"
                android:src="@drawable/ic_waveform"
                android:contentDescription="Open Voice Assistant" />
        </LinearLayout>
    </LinearLayout>

    <!-- LIVE VOICE MODE FULLSCREEN OVERLAY (Exact ChatGPT Advanced Voice Interface) -->
    <RelativeLayout
        android:id="@+id/layoutVoiceOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="35dp"
        android:background="@drawable/bg_liquid_aurora"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- TOP BAR: Circular Menu Button (Top Left) -->
        <ImageButton
            android:id="@+id/btnVoiceMenu"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_voice_circle_dark"
            android:src="@drawable/ic_chatgpt_bars"
            android:padding="12dp"
            android:contentDescription="Menu Drawer" />

        <!-- TOP BAR: Circular Voice Settings Button (Top Right) -->
        <ImageButton
            android:id="@+id/btnVoicePersonality"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_voice_circle_dark"
            android:src="@drawable/ic_chatgpt_sliders"
            android:padding="12dp"
            android:contentDescription="Voice Personality" />

        <!-- Hidden legacy anchors to preserve controller references -->
        <TextView
            android:id="@+id/tvVoiceOverlayStatus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVoiceOverlayResponse"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvVoiceInterruptHint"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnVoiceCameraVision"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- CENTER: ChatGPT Living Fluid Animated Voice Orb -->
        <com.igirs.ai.ui.CyberOrbView
            android:id="@+id/voiceOverlayOrb"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_centerInParent="true" />

        <!-- Subtle Floating Transcript Below Orb -->
        <TextView
            android:id="@+id/tvVoiceOverlayTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/voiceOverlayOrb"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="36dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Listening..."
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />

        <!-- BOTTOM BAR: ChatGPT Action Controls -->
        <LinearLayout
            android:id="@+id/layoutVoiceBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="32dp"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- "+ Ask IGIRS" Pill Button (Left) -->
            <LinearLayout
                android:id="@+id/layoutVoiceAskPill"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_voice_ask_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_plus"
                    app:tint="#A0AEC0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif"
                    android:text="Ask IGIRS"
                    android:textColor="#A0AEC0"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Circular Microphone Mute/Unmute Button (Center-Right) -->
            <ImageButton
                android:id="@+id/fabVoiceOverlayMic"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_voice_circle_dark"
                android:src="@drawable/ic_mic"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:tint="#FFFFFF"
                android:contentDescription="Mute / Unmute" />

            <!-- Circular White "✕" Close Button (Right) -->
            <ImageView
                android:id="@+id/btnCloseVoiceOverlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_voice_circle_white"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_close"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:tint="#000000"
                android:contentDescription="End Voice Session" />

        </LinearLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ChatGPT-Style Sidebar Drawer -->
    <include
        android:id="@+id/sidebarDrawer"
        layout="@layout/chat_sidebar_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
