<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_cyber_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Radio Indicator -->
    <ImageView
        android:id="@+id/ivVoiceCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/radiobutton_off_background"
        app:tint="#7E8B9F" />

    <!-- Voice Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoiceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Ava (Female)"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvVoiceDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Warm, natural &amp; friendly (ChatGPT Sky)"
            android:textColor="#8E9EB5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Preview Play Button -->
    <ImageView
        android:id="@+id/btnPreviewVoice"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="6dp"
        android:src="@drawable/ic_speaker"
        app:tint="@color/electric_cyan"
        android:contentDescription="Preview Voice" />

</LinearLayout>
