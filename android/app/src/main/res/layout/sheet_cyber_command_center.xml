<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay_sheet"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <!-- Top Drag Pill -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="#2E3C52"
        android:layout_marginBottom="14dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:text="IGIRS AI 0.2"
                android:textColor="@color/electric_cyan"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="CYBER COMMAND &amp; SETTINGS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSheetFirewallBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cyber_card"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="⚡ SECURE"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3D Cyber Orb Visualizer -->
    <com.igirs.ai.ui.CyberOrbView
        android:id="@+id/sheetCyberOrb"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="12dp" />

    <!-- Telemetry -->
    <TextView
        android:id="@+id/tvSheetTelemetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_cyber_card"
        android:padding="12dp"
        android:text="Engine: Groq LPU Cluster | Firewall: Active (AES-256 GCM)"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <!-- 6-Layer Defense-in-Depth Firewall Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="6-LAYER DEFENSE FIREWALL"
                android:textColor="@color/electric_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFirewallOverallStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100% SECURE"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLayer1Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🛡️ L1: RASP &amp; Anti-Hook (Frida/Root/PTRACE): NOMINAL"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLayer2Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🧠 L2: AI Prompt Injection Shield: ACTIVE"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLayer3Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📱 L3: OS Intent &amp; Anti-Tapjacking: ENFORCED"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLayer4Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔐 L4: Hardware Keystore Vault (AES-256 GCM): LOCKED"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLayer5Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🌐 L5: Strict TLS 1.3 &amp; Anti-MITM Network: ACTIVE"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvLayer6Status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="🔒 L6: Binary Integrity &amp; Anti-Repackage: VERIFIED"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunDeepScan"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#141B2D"
            app:strokeColor="@color/electric_cyan"
            app:strokeWidth="1dp"
            android:text="⚡ Run Live Security Diagnostic"
            android:textColor="@color/electric_cyan"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Voice Engine Test -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI VOICE ENGINE • 100% HUMAN"
            android:textColor="@color/void_purple"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Christopher Neural / SFG Network • Bold male voice."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetTestVoice"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/void_purple"
            app:strokeWidth="1dp"
            android:text="🗣️ Test Bold Human Voice"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Groq LPU Cluster Engine Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GROQ LPU MOBILE CLUSTER"
                android:textColor="@color/electric_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cyber_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="⚡ 5-NODE ACTIVE"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="✦ Engine: Groq LPU Ultra-Low Latency Inference"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="✦ Primary Model: Qwen 2.5 27B (Text &amp; Vision)"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="✦ Vault Protection: 100% Encrypted &amp; Auto-Rotating"
            android:textColor="#10B981"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- System Integration Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM INTEGRATION"
            android:textColor="@color/cyber_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetDefaultAssistant"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/cyber_blue"
            app:strokeWidth="1dp"
            android:text="@string/default_assistant_btn"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetAccessibility"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/flame_neon"
            app:strokeWidth="1dp"
            android:text="@string/enable_auto_send_btn"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

</LinearLayout>
