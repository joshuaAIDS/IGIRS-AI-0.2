<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3300F0FF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#121828" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#26FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#08FFFFFF" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#4D00F0FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
